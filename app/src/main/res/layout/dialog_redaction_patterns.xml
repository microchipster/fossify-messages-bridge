<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/activity_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/activity_margin">

        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/redaction_patterns_helper"
            android:textSize="@dimen/normal_text_size" />

        <TextView
            style="@style/SettingsSectionLabelStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/redaction_patterns_presets" />

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/redaction_preset_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/redaction_preset_otp" />

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/redaction_preset_password_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/redaction_preset_password_reset" />

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/redaction_preset_card_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/redaction_preset_card_number" />

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/redaction_preset_ssn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/redaction_preset_ssn" />

        <TextView
            style="@style/SettingsSectionLabelStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/redaction_patterns_custom" />

        <org.fossify.commons.views.MyTextInputLayout
            android:id="@+id/redaction_custom_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/redaction_patterns_custom_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/redaction_custom_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="3"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/bigger_text_size" />

        </org.fossify.commons.views.MyTextInputLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
